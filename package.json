    "jose": "^6.2.4",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "phaser": "^3.90.0",
    "prisma": "^6.16.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.55.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
